{
  "name": "recircuit",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:household": "tsc --build packages/llm packages/core packages/db && npm run build --workspace=@recircuit/web",
    "build:portals": "npm run build --workspace=@recircuit/portals",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc -p packages/llm/tsconfig.json --noEmit && tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/db/tsconfig.json --noEmit && tsc -p apps/portals/tsconfig.json --noEmit && tsc -p apps/worker/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:portals": "vitest run apps/portals",
    "test:e2e": "playwright test",
    "build": "tsc --build",
    "intake": "node scripts/intake-cli.mjs",
    "policies": "node scripts/policies-cli.mjs",
    "plan": "node scripts/plan-cli.mjs",
    "approve": "node scripts/approve-cli.mjs",
    "book": "node scripts/book-cli.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "portals:dev": "node scripts/start-portals.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.4",
    "untun": "^0.2.2",
    "vitest": "4.1.12"
  }
}
